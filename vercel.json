{
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{data/**,tests/**,reports/**,*.csv,*.pptx}"
    },
    "app.py": {
      "excludeFiles": "{data/**,tests/**,reports/**,*.csv,*.pptx}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
